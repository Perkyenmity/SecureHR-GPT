# Leave blank to call the API on the same origin (Vite proxy in dev,
# FastAPI static mount in production). Set it only if the UI is hosted
# separately, and then add CORSMiddleware to the FastAPI app.
VITE_API_URL=

# Shows demo accounts on the login screen and the "Switch user" control.
# Set to false for anything that is not a demo.
VITE_DEMO_MODE=true
